{
  "manifest_version": 3,
  "name": "The Play",
  "version": "0.1.0",
  "description": "浏览器侧的嗅探、Agent 与篡改工具；重活（播放、BT、ffmpeg、落盘）交给本机 The Play 应用。",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "webNavigation",
    "cookies",
    "downloads",
    "debugger",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
