{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "chrome"],
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "./build",
    "rootDir": "../",
    "esModuleInterop": true,
    "allowJs": true,
    "strict": false,
    "noImplicitAny": false,
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "isolatedModules": false
  },
  "include": [
    "../app/renderer/services/AudioService.ts",
    "../app/renderer/services/SpgAiService.ts",
    "../app/renderer/services/LogService.ts",
    "../app/renderer/services/SearchService.ts",
    "../app/renderer/hooks/useAudio.ts",
    "../shared/ai/AiService.ts",
    "../shared/core/**/*.ts",
    "../shared/meta/**/*.ts",
    "../extension/src/shared/classify.ts",
    "../extension/src/shared/inpage.ts",
    "../extension/src/shared/protocol.ts",
    "../extension/src/agent/**/*.ts",
    "../extension/src/offscreen/host.ts",
    "../extension/src/background/bridge-port.ts"
  ]
}
